# MatchPredict backend settings — copy to backend/.env (git-ignored) and fill in what you need.
# Every variable is optional: anything left out uses the default shown here
# (defined in src/matchpredict/config.py). Only FOOTBALL_DATA_ORG_KEY has no default.

# --- Data sources ----------------------------------------------------------
# Free football-data.org key (https://www.football-data.org/client/register).
# Enables the Champions League schedule, live scores and results, and a 14-day
# fixture horizon for the domestic leagues. Never commit the real key.
FOOTBALL_DATA_ORG_KEY=
# TheSportsDB key for the no-key UEFA fallback (UEL / UECL always, UCL without the key).
MP_THESPORTSDB_KEY=123
MP_EUROPE_INGEST_ENABLED=true
# How far back new-league result files are ingested (days).
MP_RESULTS_LOOKBACK_DAYS=365

# --- Storage & model files (defaults are relative to backend/) --------------
# MP_DATABASE_URL=sqlite:///backend/data/app.db
# MP_ARTIFACT_PATH=backend/artifacts/model.joblib
# MP_EUROPE_ARTIFACT_PATH=backend/artifacts/europe.joblib
# MP_V2_ARTIFACT_PATH=backend/artifacts/model_v2.joblib
# MP_HISTORY_CSV=data/raw/Matches.csv
# Serve the v2 model when its artifact exists and passed the promotion gate.
MP_V2_ENABLED=true

# --- Background jobs -------------------------------------------------------
MP_SCHEDULER_ENABLED=true
# Daily results + fixtures ingest (hour, UTC).
MP_INGEST_HOUR_UTC=7
# Poll live UEFA scores every N minutes while a match is in play or within ±N hours of kick-off.
MP_LIVE_REFRESH_MINUTES=2
MP_LIVE_WINDOW_HOURS=3
# Re-price pre-kickoff prediction snapshots every N minutes, for fixtures up to N days ahead.
MP_SNAPSHOT_REFRESH_MINUTES=30
MP_SNAPSHOT_DAYS_AHEAD=7
# Weekly v2 retrain; the new model is promoted only if validation log loss is not worse
# than the current one by more than the tolerance.
MP_RETRAIN_ENABLED=true
MP_RETRAIN_DAY_OF_WEEK=sun
MP_RETRAIN_HOUR_UTC=3
MP_RETRAIN_TOLERANCE=0.003

# --- API server ------------------------------------------------------------
MP_HOST=127.0.0.1
MP_PORT=8000
# Comma-separated browser origins allowed to call the API.
MP_CORS_ORIGINS=http://localhost:5173
# Requests per client IP (/health is exempt).
MP_RATE_LIMIT=60/minute
MP_LOG_LEVEL=INFO
